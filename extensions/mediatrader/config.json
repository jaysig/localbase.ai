{
  "name": "MediaTrader",
  "description": "Media spend analysis, correlation tracking, and attribution modeling",
  "version": "1.0.0",
  "presentation": "sidebar",
  "icon": "Radar",
  "channels": [
    {
      "id": "google-ads",
      "name": "Google Ads",
      "type": "search",
      "dataSource": "data/roofmaxx_google_ads/roofmaxx_google_ads.db",
      "table": "google_ads_data",
      "currency": "USD",
      "dateField": "date",
      "costField": "cost",
      "enabled": true
    },
    {
      "id": "facebook-ads",
      "name": "Facebook Ads",
      "type": "social",
      "dataSource": "data/roofmaxx_facebook_ads/facebook_daily_ad_spend.db",
      "table": "facebook_daily_ad_spend",
      "currency": "USD",
      "dateField": "date",
      "costField": "amount_spent_usd",
      "enabled": true
    },
    {
      "id": "roofmaxx-lead-invoices",
      "name": "RoofMaxx Lead Invoices",
      "type": "leads",
      "dataSource": "data/roofmaxx_invoices/roofmaxx_lead_invoices.db",
      "table": "invoice_leads_enriched_v3",
      "currency": "USD",
      "dateField": "lead_created_date",
      "costField": "lead_amount",
      "enabled": true
    }
  ],
  "conversionSources": [
    {
      "id": "roofmaxx-deals",
      "name": "RoofMaxx Deals",
      "type": "crm",
      "dataSource": "data/roofmaxx_deals/roofmaxx_deals.db",
      "table": "deals",
      "dateField": "created_at",
      "enabled": true
    },
    {
      "id": "roofr-proposals",
      "name": "Roofr Proposals",
      "type": "proposals",
      "dataSource": "data/roofr/roofr_proposals.db",
      "table": "proposals",
      "dateField": "sent_date",
      "enabled": true
    },
    {
      "id": "roofr-proposals-signed",
      "name": "Roofr Proposals Signed",
      "type": "proposals",
      "dataSource": "data/roofr/roofr_proposals.db",
      "table": "proposals",
      "dateField": "signed_date",
      "enabled": true
    },
    {
      "id": "inbound-calls",
      "name": "Inbound Calls",
      "type": "calls",
      "dataSource": "data/ringcentral/ringcentral.db",
      "table": "calls",
      "dateField": "call_start_time",
      "filterField": "call_direction",
      "filterValue": "Inbound",
      "enabled": true
    },
    {
      "id": "outbound-calls",
      "name": "Outbound Calls",
      "type": "calls",
      "dataSource": "data/ringcentral/ringcentral.db",
      "table": "calls",
      "dateField": "call_start_time",
      "filterField": "call_direction",
      "filterValue": "Outbound",
      "enabled": true
    },
    {
      "id": "revenue-collected",
      "name": "Revenue Collected",
      "type": "revenue",
      "dataSource": "data/quickbooks/quickbooks.db",
      "table": "daily_transactions",
      "dateField": "txn_date",
      "valueField": "amount",
      "filterField": "is_income",
      "filterValue": "1",
      "enabled": true
    }
  ],
  "settings": {
    "defaultTimeWindow": 90,
    "defaultAttributionWindow": 14,
    "currency": "USD"
  }
}
