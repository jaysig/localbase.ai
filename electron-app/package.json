{
  "name": "localbase-electron",
  "productName": "LocalBase",
  "version": "1.0.0",
  "description": "LocalBase Desktop App - Local-first analytics workspace",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --no-sandbox\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:clean": "rm -rf dist && npm run electron:build",
    "electron:open": "open dist/electron/mac-arm64/LocalBase.app",
    "electron:install": "./install.sh",
    "electron:clear-cache": "./clear-app-cache.sh",
    "prod": "./build.sh",
    "prod:install": "./build.sh && ./install.sh",
    "rebuild": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-label": "^2.1.8",
    "@supabase/supabase-js": "^2.78.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "apexcharts": "^4.0.0",
    "better-sqlite3": "^12.4.1",
    "chart.js": "^4.4.2",
    "chartjs-chart-venn": "^4.3.0",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.344.0",
    "ml-random-forest": "^2.1.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-apexcharts": "^1.4.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.1.6",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.localbase.app",
    "productName": "LocalBase",
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "dist/**/*",
      "!dist/electron/**/*",
      "electron/**/*",
      "!electron/server.js",
      "src/lib/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": "dmg",
      "icon": "build-resources/icon.icns"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "maintainer": "LocalBase <noreply@localbase.ai>"
    }
  }
}
