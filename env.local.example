# LocalBase Configuration
# Copy this file to env.local and add your API keys

# =============================================================================
# ANTHROPIC (Required for AI features)
# =============================================================================
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# CONNECTOR API KEYS
# =============================================================================
# Add API keys for your data connectors here.
# Each connector defines what credentials it needs in its README.

# Example:
# HUBSPOT_ACCESS_TOKEN=your_hubspot_token_here
# QUICKBOOKS_CLIENT_ID=your_qb_client_id
# QUICKBOOKS_CLIENT_SECRET=your_qb_client_secret

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================

# Surge.sh (for hosting visualizations)
# SURGE_TOKEN=your_surge_token_here

# =============================================================================
# NOTES
# =============================================================================
# - This file is ignored by git (never committed)
# - Each connector can be used independently
# - Missing API keys will disable that connector gracefully
# - Ask Claude: "Help me set up [service] connector" for guides
