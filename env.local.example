# LocalBase Insights API Configuration
# Copy this file to env.local and add your API keys

# =============================================================================
# HUBSPOT INTEGRATION (CRM Data)
# =============================================================================
# Get your token at: https://app.hubspot.com/private-apps/
# Permissions needed: CRM (read), Meetings (read), Deals (read)
HUBSPOT_ACCESS_TOKEN=your_hubspot_token_here

# =============================================================================
# G2 COMPETITIVE INTELLIGENCE
# =============================================================================
# Get your API key from G2 Buyer Intent dashboard
# Used for: competitor research, buyer intent signals, prospect intelligence
G2_API_KEY=your_g2_api_key_here

# =============================================================================
# MIXPANEL USER ANALYTICS
# =============================================================================
# Get from: https://mixpanel.com/settings/project
# Used for: user behavior, funnel analysis, cohort studies
MIXPANEL_PROJECT_TOKEN=your_mixpanel_token_here
MIXPANEL_API_SECRET=your_mixpanel_secret_here


# =============================================================================
# OPTIONAL SERVICES
# =============================================================================
# These are optional - only add if you use these services

# Surge.sh (for hosting charts)
SURGE_TOKEN=your_surge_token_here

# Additional API keys can be added as needed
# CUSTOM_API_KEY=your_custom_key_here

# =============================================================================
# CONFIGURATION NOTES
# =============================================================================
# - This file is ignored by git (never committed)
# - Each service can be used independently
# - Missing API keys will disable that service gracefully
# - Ask AI: "Help me set up [service] API integration" for step-by-step guides