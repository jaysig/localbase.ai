{
  "name": "localbase",
  "version": "1.0.0",
  "description": "LocalBase",
  "type": "module",
  "scripts": {
    "start": "node tools/server/app-server.js",
    "dev": "concurrently \"npm start\" \"cd app && npm run dev\"",
    "build": "cd app && npm run build",
    "web": "npm start & sleep 2 && open http://localhost:3000",
    "mcp": "node tools/mcp/server.js",
    "all": "npm run mcp & npm start",
    "server:watch": "node --watch tools/server/app-server.js",
    "test": "node --test test/**/*.test.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "test:coverage": "c8 --include='tools/server/**' node --test test/**/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@observablehq/plot": "^0.6.17",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.2.0",
    "chart.js": "^4.5.0",
    "chartjs-chart-venn": "^4.3.5",
    "claude-story": "^1.4.2",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.2.0",
    "d3": "^7.9.0",
    "dotenv": "^16.3.0",
    "express": "^5.1.0",
    "googleapis": "^160.0.0",
    "highcharts": "^12.4.0",
    "open": "^10.2.0",
    "sqlite3": "^5.1.7",
    "tesseract.js": "^6.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "concurrently": "^9.1.0"
  },
  "keywords": [
    "analytics",
    "local-first",
    "sqlite",
    "localbase"
  ],
  "author": "Ryan",
  "license": "MIT"
}
